[
    {emqx_plugin_kafka, [
        {kafka_address_list, [{"localhost", 9092}]},    %% kafka地址，可配置多个
        {kafka_config, [                                %% 这部分是https://github.com/kafka4beam/brod库需要的 client 配置
            {restart_delay_seconds, 5},                 %% How long to wait between attempts to restart brod_client process when it crashes.
            {reconnect_cool_down_seconds, 1},           %% Delay this configured number of seconds before retrying to establish a new connection to the kafka partition leader.
            {get_metadata_timeout_seconds, 3},          %% 拉取 metadata 的超时时间，默认 5s 偏长
            {query_api_versions, true},                 %% Kafka 0.9.x or Earlier请设置为false

            %% 注意：生产者参数必须放在 default_producer_config 里面。
            %% brod 的 auto_start_producers 只会读取 default_producer_config，
            %% 直接写在顶层会被静默忽略（旧配置就踩了这个坑）。
            {default_producer_config, [
                {partition_buffer_limit, 512},          %% 每个分区最多缓存多少条未确认消息
                {retry_backoff_ms, 500},                %% 发送失败后的重试间隔
                {max_retries, 3},                       %% 单条消息重试次数，0 表示失败即退出生产者
                {required_acks, 1},                     %% 0=不等待确认(吞吐高、可能丢消息) 1=leader确认 -1=所有ISR确认
                {ack_timeout, 1000},                    %% 仅在 required_acks 不为 0 时生效
                {max_linger_ms, 10},                    %% 攒批时间，降低 Kafka 请求数，大流量场景必开
                {max_batch_size, 65536}                 %% 单个分区单次请求的最大字节数
            ]}
        ]},
        %% 本地有界队列：Kafka 抖动时 hook 只入队不阻塞，超过任一上限直接丢弃并计数
        {queue_workers, 4},                             %% worker 进程数，按 device_id 哈希分片；30万设备建议 4~8
        {queue_max_len, 100000},                        %% 队列最多缓存多少条消息（2万条/秒约 5 秒缓冲）
        {queue_max_bytes, 134217728},                   %% 队列最多占用多少字节（默认 128MB）
        {queue_report_interval, 5000},                  %% 丢弃/发送失败统计的告警输出间隔(ms)
        {produce_timeout, 2000},                        %% worker 单条消息写入等待上限(ms)，超时计一次失败
        {fail_threshold, 3},                            %% 单个 worker 连续失败多少次后熔断，期间直接丢弃不写 Kafka
        {probe_interval, 10000},                        %% 熔断后间隔多久放行一次探测，探测成功即恢复
        %% delivered / acked 默认关闭：一条消息被 N 个订阅者消费时，Kafka 写入量会放大到 1+2N 倍
        {forward_delivered, false},                     %% 是否把 message.delivered 事件转发到 kafka
        {forward_acked, false},                         %% 是否把 message.acked 事件转发到 kafka
        {topic, <<"emqx-topic">>},                           %% 默认转发的目标kafka topic
        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
        %% 以下是对于不同的emqx hook配置不同的topic，如果没有配置则使用默认的kafka topic
        %% {on_client_heartbeat, <<"client-heartbeat-topic">>},
        %% {on_message_publish, <<"message-publish-topic">>},
        %% {on_message_delivered, <<"message-delivered-topic">>},
        %% {on_message_acked, <<"message-acked-topic">>},
        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

        %% MQTT topic 到 Kafka topic 的映射规则
        {topic_mapping, [
            {<<"/home-gateway-proxy/register-server/request">>, <<"mqtt-new-profile">>},
            {<<"/home-gateway-proxy/v1/register-server/request">>, <<"mqtt-new-profile">>},
            {<<"/home-gateway-proxy/v1/message/reply">>, <<"fttr-mqtt-tls-topic">>},
            {<<"/home-gateway-proxy/v1/notify-event/request">>, <<"iot-mqtt-event">>},
            {<<"/maxnet/v1/message/reply">>, <<"maxnet-mqtt-reply">>},
            {<<"/maxnet/v1/notify-event/request">>, <<"maxnet-mqtt-event">>},
            {<<"/maxnet/v1/notify-event/high-prority-event">>, <<"maxnet-mqtt-high-event">>}
        ]},

        %% 客户端publish消息到mqtt时，如果匹配上以下任意一个mqtt topic名称前缀，则该消息不会再转发到kafka中
        %% 注意：只做前缀匹配
        {mqtt_topic_pattern_ignored_list, [
            %% <<"/test">>, 示例，表示发布到以/test开头的mqtt topic的消息不会转发到kafka中
            %% <<"">>, 示例，表示所有mqtt topic中的消息都不会转发到kafka中
        ]},
        {publish_base64, false}                         %% 对于publish到mqtt的消息内容，是否进行base64编码之后再转发（为了兼容发送字节流的情况）
    ]}
].
